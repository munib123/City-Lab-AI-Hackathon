# Copy to .env.local and fill in. Never commit real keys.

# Chat is the only feature that needs an LLM. Without a key the app still
# classifies every report; only the chat panel is disabled.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Main model for chat. Run `python scripts/check_llm.py` to list the models your key can use.
GEMINI_MODEL=gemini-2.5-flash
# Tried once when the main model is busy, rate-limited or slow (free-tier limits are per model).
# Leave empty to switch the fallback off.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Alternative provider (same adapter interface)
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
