# Copy to .env.local and fill in. Never commit real keys.

# Chat is the only feature that needs an LLM. Without a key the app still
# classifies every report; only the chat panel is disabled.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Check Google AI Studio for the current free-tier model name.
GEMINI_MODEL=gemini-2.5-flash

# Alternative provider (same adapter interface)
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
